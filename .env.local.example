# Copy to .env.local and fill in. Never commit .env.local.

# AI provider routing (per spec §15.9)
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5

# Google Sheets (per spec §15.10)
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Paste the full -----BEGIN PRIVATE KEY-----...-----END PRIVATE KEY----- block
# Replace literal \n with actual newlines, OR keep \n and lib/sheets/client.ts will normalise
GOOGLE_PRIVATE_KEY=

# Optional: where bootstrap-sheet.ts shares the new sheet
SHEET_OWNER_EMAIL=
